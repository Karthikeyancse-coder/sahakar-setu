# Copy this file to .env and fill in real values from your Supabase project settings.
# Settings → Database → Connection string

# Supabase connection pooler (port 6543, Transaction mode) — used at runtime by the app
# Paste the "Connection pooling" string here and append ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase direct connection (port 5432) — used by Prisma CLI (migrate, seed, studio)
# Paste the "Direct connection" string here (no pgbouncer suffix)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

JWT_SECRET="replace-with-a-long-random-secret"
PORT=5000
NODE_ENV=development

# Career Sahayak chatbot — Gemini 1.5 Flash (RAG-augmented responses)
# Get your key from: https://aistudio.google.com/app/apikey
# If omitted, the chatbot falls back to rule-based responses (no Gemini call).
GEMINI_API_KEY="your-google-ai-studio-api-key-here"
